# Copy this file to .env and fill in your keys.
# Never commit .env — it is blocked by .gitignore.

# --- Required ---
EIA_API_KEY=
EMBER_API_KEY=
GIE_API_KEY=
ENTSOE_API_KEY=
FRED_API_KEY=

# --- pipelines/futures (Spec 18) -- not secrets, plain connection/selection params ---
# FUTURES_SOURCE=manual   # "manual" (data/manual/futures/settles_*.csv) or "ibkr"
# IBKR_HOST=127.0.0.1     # only used when FUTURES_SOURCE=ibkr
# IBKR_PORT=7497          # 7497=TWS paper, 7496=TWS live, 4002=Gateway paper, 4001=Gateway live
# IBKR_CLIENT_ID=1

# --- Optional (later sessions / pipelines) ---
NEWSAPI_KEY=
WORLDNEWS_KEY=
AISSTREAM_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
MAPBOX_TOKEN=
TOMORROW_IO_KEY=
GUARDIAN_KEY=
ADANOS_API_KEY=
ANTHROPIC_API_KEY=

# pipelines/jodi_gas: free account at https://www.jodidata.org/sign-up.aspx
JODI_USERNAME=
JODI_PASSWORD=
