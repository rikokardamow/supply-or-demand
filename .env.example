# Copy this file to .env and fill in your keys.
# Never commit .env — it is blocked by .gitignore.

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/kardamow

# Supabase Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GIE (AGSI+ storage + ALSI LNG) — used as x-key header
AGSI_KEY=
GIE_KEY=

# EIA (US natural gas storage + Henry Hub)
EIA_KEY=

# FRED (macro overlays)
FRED_KEY=

# Ember (electricity / energy data)
EMBER_KEY=

# WorldNews API
WORLDNEWS_KEY=

# NewsAPI
NEWS_API_KEY=

# ECMWF (weather archive)
ECMWF_KEY=
ECMWF_EMAIL=
ECMWF_URL=https://api.ecmwf.int/v1

# Notifications
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=

# Phase 2
SUBSTACK_PUBLISH_TOKEN=

# Observability
LOGFIRE_TOKEN=

# App
APP_BASE_URL=https://pro.kardamow.com
ENVIRONMENT=development
