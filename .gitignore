# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual envs
.venv/
venv/
env/

# uv
.uv/

# Environment. `.env.*` catches .env.production / .env.prod / anything future; the
# negation keeps the committed templates tracked.
.env
.env.*
!.env.example
!.env.*.example

# Credential material, by shape rather than by name -- nothing of this kind is tracked
# today and nothing of this kind should become tracked by accident.
secrets.json
credentials.json
*.pem
*.key
*.p12
*.pfx

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Local data / snapshots
manual_settlements/*.csv
!manual_settlements/.gitkeep
# Manual drops. specs/00_TRADING_CONVENTIONS.md says these are git-ignored, but the
# `manual_settlements/` rule above never matched the real path the code uses
# (`pipelines/futures/client.py::MANUAL_FUTURES_DIR` is `data/manual/futures`), so
# nothing under data/manual/ was actually ignored.
# Widened 2026-10-10 from `data/manual/**/*.csv`: only CSV was ignored, so an operator
# Excel workbook dropped here was committable. These drops are licensed vendor data
# (Platts/Argus/Aramco per pipelines/manual_physical/CLAUDE.md) plus the user's own
# models -- none of it may reach a remote, whatever its extension.
data/manual/**
!data/manual/**/

# Generated lake and cache output of every kind, not just parquet. A stray .json or
# .csv written into the lake by a future pipeline is still generated output.
data/lake/**
data/cache/**
!data/lake/**/
!data/cache/**/

*.parquet
*.duckdb
data/raw/
data/lake/maps/

# Keep the directory sentinels visible despite the recursive rules above. Must stay
# after them: in gitignore the last matching rule wins.
!**/.gitkeep

# Logs
*.log
logs/

# Superpowers brainstorming companion (mockups, server state)
.superpowers/

# Portfolio site build output
site/.next/
site/node_modules/
site/.vercel/

# Build artefacts and local run output. tsbuildinfo is a machine-specific incremental
# cache -- it was tracked by accident and produces a diff on every build.
*.tsbuildinfo
*.log
.next/
site/site.log

# Playwright MCP scratch output
.playwright-mcp/

# Business planning — pricing, tiers and roadmap targets. Kept locally and out of the
# public repository; a copy is in ../kardamow-private/.
PROJECT_BRIEF.md

# Publishing-layer Office exports (apps/artifacts/office.py) -- rebuilt from the lake by
# `python -m apps.artifacts.build`; binary, and they embed lake data.
exports/
