# Publishable (anon) key -- read-only by RLS, safe in the browser. Never put the
# service-role key or SUPABASE_DB_URL here: this file's values are inlined into the
# client bundle by Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-anon-key>

# Server-only (no NEXT_PUBLIC_ prefix, so Next never inlines it into the browser
# bundle). Shared with the Python pipelines, which send it as x-revalidate-secret.
REVALIDATE_SECRET=<generate-a-long-random-string>
